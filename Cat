-- ============ CONFIG SAVE/LOAD ============
local CONFIG_FILE = "AuraMods_Config.json"

local function saveConfig()
    if type(writefile) ~= "function" then return false end
    local data = {
        ESP = ESP,
        AIM = {
            enabled = AIM.enabled,
            fov = AIM.fov,
            smoothness = AIM.smoothness,
            teamCheck = AIM.teamCheck,
            visibleOnly = AIM.visibleOnly,
            showFov = AIM.showFov,
            targetPart = AIM.targetPart
        },
        PLAYER = {
            walkSpeed = PLAYER.walkSpeed,
            jumpPower = PLAYER.jumpPower,
            tpWalk = PLAYER.tpWalk,
            tpWalkSpeed = PLAYER.tpWalkSpeed,
            cameraFov = PLAYER.cameraFov,
            flySpeed = PLAYER.flySpeed,
            noclip = PLAYER.noclip,
            infJump = PLAYER.infJump,
            touchTP = PLAYER.touchTP
        },
        currentLang = currentLang,
        currentThemeIndex = currentThemeIndex,
        FULLBRIGHT = FULLBRIGHT,
        NO_FOG = NO_FOG,
        ANTI_AFK = ANTI_AFK,
        ANTI_FLING = ANTI_FLING,
        POTATO = POTATO
    }
    local ok = pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
    return ok
end

local function loadConfig()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return false end
    if not isfile(CONFIG_FILE) then return false end
    local ok, content = pcall(readfile, CONFIG_FILE)
    if not ok or not content or content == "" then return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or not data then return false end

    if data.ESP then
        for k, v in pairs(data.ESP) do ESP[k] = v end
    end
    if data.AIM then
        for k, v in pairs(data.AIM) do AIM[k] = v end
    end
    if data.PLAYER then
        for k, v in pairs(data.PLAYER) do PLAYER[k] = v end
        local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if h then
            h.WalkSpeed = PLAYER.walkSpeed
            h.UseJumpPower = true
            h.JumpPower = PLAYER.jumpPower
        end
        if camera then camera.FieldOfView = PLAYER.cameraFov end
    end
    if data.currentLang then currentLang = data.currentLang end
    if data.currentThemeIndex and THEMES[data.currentThemeIndex] then
        currentThemeIndex = data.currentThemeIndex
        currentThemeColor = THEMES[currentThemeIndex].color
    end
    if data.FULLBRIGHT ~= nil then FULLBRIGHT = data.FULLBRIGHT; applyFullbright(FULLBRIGHT) end
    if data.NO_FOG ~= nil then NO_FOG = data.NO_FOG; applyNoFog(NO_FOG) end
    if data.ANTI_AFK ~= nil then ANTI_AFK = data.ANTI_AFK end
    if data.ANTI_FLING ~= nil then ANTI_FLING = data.ANTI_FLING end
    return true
end

