local function getTeamType(plr)
    local myTeam, theirTeam = player.Team, plr.Team
    local myTC, theirTC = player.TeamColor, plr.TeamColor
    local neutral = {
        [BrickColor.new("White").Number] = true,
        [BrickColor.new("Medium stone grey").Number] = true,
        [BrickColor.new("Light stone grey").Number] = true,
        [BrickColor.new("Institutional white").Number] = true,
    }
    local function isNeutral(bc) if not bc then return true end; return neutral[bc.Number] == true end
    if myTeam and theirTeam then
        if myTeam == theirTeam then return "friend" end
        return "enemy"
    end
    if isNeutral(myTC) or isNeutral(theirTC) then return "neutral" end
    if myTC == theirTC then return "friend" end
    return "enemy"
end

local function isTeammate(plr) return getTeamType(plr) == "friend" end

