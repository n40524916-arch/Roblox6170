        aimCircle.Radius = AIM.fov
        aimCircle.Color = currentThemeColor
        pcall(function()
            aimCircle.Position = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
        end)
    end

    if not AIM.enabled then return end
    if UserInputService.TouchEnabled == false and not aimActive then return end

    local target = getAimbotTarget()
    if not target then return end

    local targetPos = target.Position
    local currentCF = camera.CFrame
    local targetCF = CFrame.new(currentCF.Position, targetPos)
    local newCF = currentCF:Lerp(targetCF, math.clamp(AIM.smoothness, 0.01, 1))
    pcall(function() camera.CFrame = newCF end)
end)

