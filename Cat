local function isVisibleToCamera(plr, hrp)
    if not hrp then return false end
    local origin = camera.CFrame.Position
    local dir = hrp.Position - origin
    local params = RaycastParams.new()
    pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end)
    if params.FilterType ~= Enum.RaycastFilterType.Exclude then
        pcall(function() params.FilterType = Enum.RaycastFilterType.Blacklist end)
    end
    local filter = {camera, espFolder}
    if plr.Character then table.insert(filter, plr.Character) end
    if player.Character then table.insert(filter, player.Character) end
    params.FilterDescendantsInstances = filter
    local r = workspace:Raycast(origin, dir, params)
    return r == nil
end

local function newEsp()
    local cache = {}
    local h = Instance.new("Highlight")
    h.Name = "AM_HL"
    h.FillTransparency = 0.55
    h.OutlineTransparency = 0
    pcall(function() h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end)
    h.Parent = espFolder
    cache.hl = h

    if hasDrawing then
        pcall(function()
            cache.box = Drawing.new("Square")
            cache.box.Visible = false
            cache.box.Thickness = 1
            cache.box.Filled = false

            cache.filled = Drawing.new("Square")
            cache.filled.Visible = false
            cache.filled.Thickness = 0
            cache.filled.Filled = true
            cache.filled.Transparency = 0.75

            cache.corners = {}
            for i=1,8 do
                local line = Drawing.new("Line")
                line.Visible = false
                line.Thickness = 2
                cache.corners[i] = line
            end

            cache.hBg = Drawing.new("Square")
            cache.hBg.Visible = false
            cache.hBg.Thickness = 0
            cache.hBg.Filled = true
            cache.hBg.Transparency = 0.3
            cache.hBg.Color = Color3.fromRGB(0,0,0)

            cache.hBar = Drawing.new("Square")
            cache.hBar.Visible = false
            cache.hBar.Thickness = 0
            cache.hBar.Filled = true
            cache.hBar.Transparency = 0.15

            cache.name = Drawing.new("Text")
            cache.name.Visible = false
            cache.name.Size = 16
            cache.name.Center = true
            cache.name.Outline = true
            cache.name.OutlineColor = Color3.fromRGB(0,0,0)
            cache.name.Font = 2

            cache.dist = Drawing.new("Text")
            cache.dist.Visible = false
            cache.dist.Size = 14
            cache.dist.Center = true
            cache.dist.Outline = true
            cache.dist.OutlineColor = Color3.fromRGB(0,0,0)
            cache.dist.Font = 2

            cache.tracer = Drawing.new("Line")
            cache.tracer.Visible = false
            cache.tracer.Thickness = 1

            cache.headDot = Drawing.new("Circle")
            cache.headDot.Visible = false
            cache.headDot.Thickness = 1
            cache.headDot.Filled = true
            cache.headDot.Radius = 4

            cache.skeletonLines = {}
            for i=1,20 do
                local line = Drawing.new("Line")
                line.Visible = false
                line.Thickness = 1
                line.Color = Color3.fromRGB(255,255,255)
                cache.skeletonLines[i] = line
            end

            cache.arrow = Drawing.new("Triangle")
            cache.arrow.Visible = false
            cache.arrow.Thickness = 1
            cache.arrow.Filled = true
        end)
    end
    return cache
end

local function removeEsp(cache)
    if cache.hl then pcall(function() cache.hl:Destroy() end) end
    if hasDrawing then
        pcall(function()
            if cache.box then cache.box:Remove() end
            if cache.filled then cache.filled:Remove() end
            if cache.corners then for _, l in pairs(cache.corners) do l:Remove() end end
            if cache.hBg then cache.hBg:Remove() end
            if cache.hBar then cache.hBar:Remove() end
            if cache.name then cache.name:Remove() end
            if cache.dist then cache.dist:Remove() end
            if cache.tracer then cache.tracer:Remove() end
            if cache.headDot then cache.headDot:Remove() end
            if cache.skeletonLines then for _, l in pairs(cache.skeletonLines) do l:Remove() end end
            if cache.arrow then cache.arrow:Remove() end
        end)
    end
end

local function hideEsp(cache)
    if cache.hl then cache.hl.Enabled = false end
    if hasDrawing then
        pcall(function()
            if cache.box then cache.box.Visible = false end
            if cache.filled then cache.filled.Visible = false end
            if cache.corners then for _, l in pairs(cache.corners) do l.Visible = false end end
            if cache.hBg then cache.hBg.Visible = false end
            if cache.hBar then cache.hBar.Visible = false end
            if cache.name then cache.name.Visible = false end
            if cache.dist then cache.dist.Visible = false end
            if cache.tracer then cache.tracer.Visible = false end
            if cache.headDot then cache.headDot.Visible = false end
            if cache.skeletonLines then for _, l in pairs(cache.skeletonLines) do l.Visible = false end end
            if cache.arrow then cache.arrow.Visible = false end
        end)
    end
end

local function getSkeletonPoints(char)
    if not char then return nil end
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local larm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
    local rarm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
    local lleg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg")
    local rleg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg")
    local lhand = char:FindFirstChild("LeftHand") or char:FindFirstChild("LeftLowerArm")
    local rhand = char:FindFirstChild("RightHand") or char:FindFirstChild("RightLowerArm")
    local lfoot = char:FindFirstChild("LeftFoot") or char:FindFirstChild("LeftLowerLeg")
    local rfoot = char:FindFirstChild("RightFoot") or char:FindFirstChild("RightLowerLeg")
    if not head or not hrp then return nil end
    return {
        head = head, hrp = hrp,
        larm = larm, rarm = rarm,
        lleg = lleg, rleg = rleg,
        lhand = lhand or larm, rhand = rhand or rarm,
        lfoot = lfoot or lleg, rfoot = rfoot or rleg
    }
end

