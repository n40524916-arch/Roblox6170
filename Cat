local function getAimbotTarget()
    local closest, closestDist = nil, math.huge
    local screenCenter = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local isFriend = isTeammate(plr)
            if not (AIM.teamCheck and isFriend) then
                local char = plr.Character
                local part = char and (char:FindFirstChild(AIM.targetPart) or char:FindFirstChild("Head"))
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if part and hrp and hum and hum.Health > 0 then
                    local visOK = true
                    if AIM.visibleOnly then visOK = isVisibleToCamera(plr, hrp) end
                    if visOK then
                        local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                        if onScreen and pos.Z > 0 then
                            local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                            if dist <= AIM.fov and dist < closestDist then
                                closestDist = dist
                                closest = part
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if aimCircle then
