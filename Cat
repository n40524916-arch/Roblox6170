UserInputService.TouchTap:Connect(function(touchPositions, gameProcessed)
    if gameProcessed then return end
    if not PLAYER.touchTP then return end
    local pos = touchPositions and touchPositions[1]
    if not pos then return end

    local ray = camera:ViewportPointToRay(pos.X, pos.Y)
    local params = RaycastParams.new()
    pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end)
    if params.FilterType ~= Enum.RaycastFilterType.Exclude then
        pcall(function() params.FilterType = Enum.RaycastFilterType.Blacklist end)
    end
    local filter = {camera}
    if player.Character then table.insert(filter, player.Character) end
    params.FilterDescendantsInstances = filter
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    if hit then
        local hrp = getHRP()
        if hrp then
            pcall(function() hrp.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3, 0)) end)
        end
    end
end)

