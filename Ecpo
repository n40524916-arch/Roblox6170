-- Yardımcılar
local function stroke(p, t, c, tr)
    local s = Instance.new("UIStroke")
    s.Thickness = t
    s.Color = c or Color3.fromRGB(255,255,255)
    s.Transparency = tr or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p
    return s
end

local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 0)
    c.Parent = p
    return c
end

local function draggable(frame, handle)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

local function slideIn(frame)
    local target = frame:GetAttribute("TargetPos")
    local base = frame:GetAttribute("BaseBG") or 0.3
    frame.Visible = true
    frame.Position = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset - 40)
    frame.BackgroundTransparency = 1
    TweenService:Create(frame, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = target, BackgroundTransparency = base
    }):Play()
    for _, d in ipairs(frame:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            d.TextTransparency = 1
            TweenService:Create(d, TweenInfo.new(0.45), {TextTransparency = 0}):Play()
        elseif d:IsA("UIStroke") then
            local t = d:GetAttribute("BaseT") or 0
            TweenService:Create(d, TweenInfo.new(0.45), {Transparency = t}):Play()
        elseif d:IsA("Frame") and d:GetAttribute("BaseBG") then
            local b = d:GetAttribute("BaseBG")
            d.BackgroundTransparency = 1
            TweenService:Create(d, TweenInfo.new(0.45), {BackgroundTransparency = b}):Play()
        end
    end
end

local function slideOut(frame, cb)
    local target = frame:GetAttribute("TargetPos")
    local t = TweenService:Create(frame, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset - 40),
        BackgroundTransparency = 1
    })
    for _, d in ipairs(frame:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            TweenService:Create(d, TweenInfo.new(0.32), {TextTransparency = 1}):Play()
        elseif d:IsA("UIStroke") then
            TweenService:Create(d, TweenInfo.new(0.32), {Transparency = 1}):Play()
        elseif d:IsA("Frame") and d:GetAttribute("BaseBG") then
            TweenService:Create(d, TweenInfo.new(0.32), {BackgroundTransparency = 1}):Play()
        end
    end
    t.Completed:Connect(function()
        frame.Visible = false
        frame.Position = target
        if cb then cb() end
    end)
    t:Play()
end

