-- FPS sayacı
local frames, lastTime, fps = 0, tick(), 0
RunService.RenderStepped:Connect(function()
    frames = frames + 1
    local now = tick()
    if now - lastTime >= 1 then
        fps = frames
        frames = 0
        lastTime = now
    end
end)

-- Status bar içeriği
