-- ================== POTATO MOD ==================
local potatoSaved = {
    textures = {},
    lighting = {
        Brightness = nil, Ambient = nil, OutdoorAmbient = nil,
        FogEnd = nil, FogStart = nil, GlobalShadows = nil,
        EnvironmentDiffuseScale = nil, EnvironmentSpecularScale = nil,
        Technology = nil
    },
    sky = nil,
    atmosphere = nil,
    postEffects = {}
}

local function enablePotatoMode()
    -- Lighting kaydet
    potatoSaved.lighting.Brightness = Lighting.Brightness
    potatoSaved.lighting.Ambient = Lighting.Ambient
    potatoSaved.lighting.OutdoorAmbient = Lighting.OutdoorAmbient
    potatoSaved.lighting.FogEnd = Lighting.FogEnd
    potatoSaved.lighting.FogStart = Lighting.FogStart
    potatoSaved.lighting.GlobalShadows = Lighting.GlobalShadows
    potatoSaved.lighting.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
    potatoSaved.lighting.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
    pcall(function() potatoSaved.lighting.Technology = Lighting.Technology end)

    -- Sky ve Atmosphere kaydet
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("Sky") then
            potatoSaved.sky = v
            v.Parent = nil
        elseif v:IsA("Atmosphere") then
            potatoSaved.atmosphere = v
            v.Parent = nil
        elseif v:IsA("PostEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect")
            or v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") then
            if v.Enabled then
                table.insert(potatoSaved.postEffects, v)
                v.Enabled = false
            end
        end
    end

    -- Doku temizleme (workspace)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") then
            potatoSaved.textures[obj] = obj.Texture
            obj.Texture = ""
        elseif obj:IsA("SurfaceAppearance") then
            potatoSaved.textures[obj] = obj.Parent
            obj.Parent = nil
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            if obj.Enabled then
                obj.Enabled = false
                table.insert(potatoSaved.postEffects, obj)
            end
        end
    end

    -- Terrain
    pcall(function()
        if workspace.Terrain then
            workspace.Terrain.WaterWaveSize = 0
            workspace.Terrain.WaterWaveSpeed = 0
            workspace.Terrain.WaterReflectance = 0
            workspace.Terrain.WaterTransparency = 1
            workspace.Terrain.Decoration = false
        end
    end)

    -- Lighting ayarları
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e9
    Lighting.FogStart = 1e9
    Lighting.Brightness = 3
    Lighting.Ambient = Color3.fromRGB(210,210,210)
    Lighting.OutdoorAmbient = Color3.fromRGB(210,210,210)
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
end

local function disablePotatoMode()
    -- Dokuları geri yükle
    for obj, tex in pairs(potatoSaved.textures) do
        pcall(function()
            if typeof(tex) == "Instance" then
                tex.Parent = obj
            else
                obj.Texture = tex
            end
        end)
    end
    potatoSaved.textures = {}

    -- Emitter/effect geri aç
    for _, v in ipairs(potatoSaved.postEffects) do
        pcall(function() v.Enabled = true end)
    end
    potatoSaved.postEffects = {}

    -- Sky / Atmosphere geri
    if potatoSaved.sky then pcall(function() potatoSaved.sky.Parent = Lighting end) end
    if potatoSaved.atmosphere then pcall(function() potatoSaved.atmosphere.Parent = Lighting end) end
    potatoSaved.sky = nil
    potatoSaved.atmosphere = nil

    -- Lighting geri
    local L = potatoSaved.lighting
    if L.Brightness then Lighting.Brightness = L.Brightness end
    if L.Ambient then Lighting.Ambient = L.Ambient end
    if L.OutdoorAmbient then Lighting.OutdoorAmbient = L.OutdoorAmbient end
    if L.FogEnd then Lighting.FogEnd = L.FogEnd end
    if L.FogStart then Lighting.FogStart = L.FogStart end
    if L.GlobalShadows ~= nil then Lighting.GlobalShadows = L.GlobalShadows end
    if L.EnvironmentDiffuseScale then Lighting.EnvironmentDiffuseScale = L.EnvironmentDiffuseScale end
    if L.EnvironmentSpecularScale then Lighting.EnvironmentSpecularScale = L.EnvironmentSpecularScale end

    applyFullbright()
end

