local function clearContent()
    for _, c in ipairs(contentScroll:GetChildren()) do c:Destroy() end
    currentY = 0
    -- Ölü label referanslarını temizle
    for i = #langLabels, 1, -1 do
        local entry = langLabels[i]
        if not entry.label or not entry.label.Parent then
            table.remove(langLabels, i)
        end
    end
end

local function loadCategory(index)
    currentCategoryIndex = index
    clearContent()
    local cat = categories[index]
    contentTitle.Text = cat.icon .. "  " .. T(cat.nameKey)
    cat.build(contentScroll)
    -- Satır animasyonları
    local delay = 0
    for _, c in ipairs(contentScroll:GetChildren()) do
        local targetY = c.Position.Y.Offset
        c.BackgroundTransparency = 1
        c.Position = UDim2.new(c.Position.X.Scale, c.Position.X.Offset, c.Position.Y.Scale, targetY + 12)
        local baseBG = 0.4
        if c.BackgroundColor3.R > 0.15 and c.BackgroundColor3.G < 0.15 then baseBG = 0.3 end
        TweenService:Create(c, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = baseBG,
            Position = UDim2.new(c.Position.X.Scale, c.Position.X.Offset, c.Position.Y.Scale, targetY)
        }):Play()
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                d.TextTransparency = 1
                TweenService:Create(d, TweenInfo.new(0.28), {TextTransparency = 0}):Play()
            end
        end
    end
end

