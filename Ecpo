    while gui.Parent do
        local ping = 0
        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        local txt = string.format("AuraMods %s  |  %s  |  %s  |  FPS: %d  |  Ping: %dms", VERSION, player.Name, gameName, fps, ping)
        statusLabel.Text = txt
        fitStatusBar(txt)
        task.wait(0.5)
    end
end)
