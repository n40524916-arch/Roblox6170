task.spawn(function()
    local hue = 0
    while true do
        task.wait(0.05)
        local theme = THEMES[currentThemeIndex]
        if theme.rgb then
            hue = hue + 0.01
            if hue > 1 then hue = 0 end
            currentThemeColor = hueToRgb(hue)
            for _, fn in ipairs(themeListeners) do
                pcall(fn, currentThemeColor)
            end
        end
    end
end)

