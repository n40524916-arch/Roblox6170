local function isTeammate(plr)
    local myTeam = player.Team
    if not myTeam then return false end
    return plr.Team == myTeam
end

local function isVisibleToCamera(plr, hrp)
    local origin = camera.CFrame.Position
    local dir = hrp.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {camera, espFolder}
    if plr.Character then table.insert(filterList, plr.Character) end
    if player.Character then table.insert(filterList, player.Character) end
    params.FilterDescendantsInstances = filterList
    local result = workspace:Raycast(origin, dir, params)
    return result == nil
end

local function createDrawings()
    if not hasDrawing then return nil end
    local ok, d = pcall(function()
        local box = Drawing.new("Square"); box.Visible=false; box.Thickness=1; box.Filled=false; box.Transparency=1; box.Color=COLOR_VISIBLE
        local filledBox = Drawing.new("Square"); filledBox.Visible=false; filledBox.Thickness=0; filledBox.Filled=true; filledBox.Transparency=0.75; filledBox.Color=COLOR_VISIBLE
        local corners = {}
        for i=1,8 do
            local line = Drawing.new("Line"); line.Visible=false; line.Thickness=2; line.Transparency=1; line.Color=COLOR_VISIBLE
            corners[i]=line
        end
        local healthBg = Drawing.new("Square"); healthBg.Visible=false; healthBg.Thickness=0; healthBg.Filled=true; healthBg.Transparency=0.3; healthBg.Color=Color3.fromRGB(0,0,0)
        local healthBar = Drawing.new("Square"); healthBar.Visible=false; healthBar.Thickness=0; healthBar.Filled=true; healthBar.Transparency=0.15; healthBar.Color=Color3.fromRGB(0,255,0)
        local nm = Drawing.new("Text"); nm.Visible=false; nm.Size=14; nm.Center=true; nm.Outline=true; nm.OutlineColor=Color3.fromRGB(0,0,0); nm.Font=2; nm.Color=COLOR_VISIBLE
        local dist = Drawing.new("Text"); dist.Visible=false; dist.Size=12; dist.Center=true; dist.Outline=true; dist.OutlineColor=Color3.fromRGB(0,0,0); dist.Font=2; dist.Color=COLOR_VISIBLE
        local tracer = Drawing.new("Line"); tracer.Visible=false; tracer.Thickness=1; tracer.Transparency=1; tracer.Color=COLOR_VISIBLE
        local headDot = Drawing.new("Circle"); headDot.Visible=false; headDot.Thickness=1; headDot.Filled=true; headDot.Radius=3; headDot.Color=COLOR_VISIBLE; headDot.Transparency=1
        return {box=box, filledBox=filledBox, corners=corners, healthBg=healthBg, healthBar=healthBar, name=nm, dist=dist, tracer=tracer, headDot=headDot}
    end)
    if ok then return d end
    return nil
end

local function clearDrawingsFor(plr)
    local d = drawings[plr]
    if d then
        pcall(function()
            d.box:Remove(); d.filledBox:Remove()
            for _, l in pairs(d.corners) do l:Remove() end
            d.healthBg:Remove(); d.healthBar:Remove(); d.name:Remove(); d.dist:Remove(); d.tracer:Remove(); d.headDot:Remove()
        end)
        drawings[plr] = nil
    end
end

local function updateHighlight(plr, char, visible)
    if ESP.body and char then
        if not highlights[plr] then
            local ok, h = pcall(function()
                local hl = Instance.new("Highlight")
                hl.Name = "AuraModsHL"
                hl.FillTransparency = 0.7
                hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = char
                hl.Parent = espFolder
                return hl
            end)
            if ok then highlights[plr] = h end
        else
            highlights[plr].Adornee = char
        end
        if highlights[plr] then
            highlights[plr].Enabled = true
            local col = visible and COLOR_VISIBLE or COLOR_HIDDEN
            highlights[plr].FillColor = col
            highlights[plr].OutlineColor = col
        end
    else
        if highlights[plr] then highlights[plr].Enabled = false end
    end
end

local function hideAllDrawings(d)
    d.box.Visible = false; d.filledBox.Visible = false
