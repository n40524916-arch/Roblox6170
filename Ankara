local function regLabel(lbl, key, prefix, suffix)
    prefix = prefix or ""
    suffix = suffix or ""
    table.insert(langLabels, {label = lbl, key = key, prefix = prefix, suffix = suffix})
    lbl.Text = prefix .. T(key) .. suffix
end

local function refreshLabels()
    for i = #langLabels, 1, -1 do
        local entry = langLabels[i]
        if entry.label and entry.label.Parent then
            entry.label.Text = (entry.prefix or "") .. T(entry.key) .. (entry.suffix or "")
        else
            table.remove(langLabels, i)
        end
    end
end

