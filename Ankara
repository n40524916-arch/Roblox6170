local function removeEsp(cache)
    if cache.hl then pcall(function() cache.hl:Destroy() end) end
    if hasDrawing then
        pcall(function()
            for _, k in ipairs({"box","filled","hBg","hBar","hpText","name","dist","tracer","headDot","arrow"}) do
                if cache[k] then cache[k]:Remove() end
            end
            if cache.corners then for _, l in pairs(cache.corners) do l:Remove() end end
            if cache.skeletonLines then for _, l in pairs(cache.skeletonLines) do l:Remove() end end
        end)
    end
end

local function hideEsp(cache)
    if cache.hl then cache.hl.Enabled = false end
    if hasDrawing then
        pcall(function()
            for _, k in ipairs({"box","filled","hBg","hBar","hpText","name","dist","tracer","headDot","arrow"}) do
                if cache[k] then cache[k].Visible = false end
            end
            if cache.corners then for _, l in pairs(cache.corners) do l.Visible = false end end
            if cache.skeletonLines then for _, l in pairs(cache.skeletonLines) do l.Visible = false end end
        end)
    end
end

local function getSkeletonPoints(char)
    if not char then return nil end
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local larm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
    local rarm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
    local lleg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg")
    local rleg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg")
    local lhand = char:FindFirstChild("LeftHand") or char:FindFirstChild("LeftLowerArm")
    local rhand = char:FindFirstChild("RightHand") or char:FindFirstChild("RightLowerArm")
    local lfoot = char:FindFirstChild("LeftFoot") or char:FindFirstChild("LeftLowerLeg")
    local rfoot = char:FindFirstChild("RightFoot") or char:FindFirstChild("RightLowerLeg")
    if not head or not hrp then return nil end
    return {head=head, hrp=hrp, larm=larm, rarm=rarm, lleg=lleg, rleg=rleg,
        lhand=lhand or larm, rhand=rhand or rarm, lfoot=lfoot or lleg, rfoot=rfoot or rleg}
end

local function setupEspCharacter(plr)
    if plr == player then return end
    if not espCache[plr] then espCache[plr] = newEsp() end
    local cache = espCache[plr]
    if plr.Character and cache.hl then cache.hl.Adornee = plr.Character end
end

for _, plr in ipairs(Players:GetPlayers()) do setupEspCharacter(plr) end

Players.PlayerAdded:Connect(function(plr)
    task.wait(0.5)
    setupEspCharacter(plr)
    plr.CharacterAdded:Connect(function(char)
        task.wait(0.3)
        if espCache[plr] and espCache[plr].hl then espCache[plr].hl.Adornee = char end
    end)
end)

Players.PlayerRemoving:Connect(function(plr)
    if espCache[plr] then removeEsp(espCache[plr]); espCache[plr] = nil end
    if SPECTATE.target == plr then SPECTATE.target = nil; SPECTATE.active = false end
end)

RunService.RenderStepped:Connect(function()
    local anyOn = ESP.chams or ESP.box or ESP.filled or ESP.corner or ESP.health or ESP.healthText or ESP.name or ESP.distance or ESP.tracers or ESP.headDot or ESP.skeleton or ESP.offscreen
    if not anyOn then
        for _, cache in pairs(espCache) do hideEsp(cache) end
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            if not espCache[plr] then espCache[plr] = newEsp() end
            local cache = espCache[plr]
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local alive = hrp and head and hum and hum.Health > 0

            if not alive then
                hideEsp(cache)
            else
                local isFriend = isTeammate(plr)
                if ESP.teamCheck and isFriend then
                    hideEsp(cache)
                else
                    local visible = true
                    if ESP.wallCheck then visible = isVisibleToCamera(plr, hrp) end
                    local col = getEspColor(plr, visible)

                    if ESP.chams and cache.hl then
                        if cache.hl.Adornee ~= char then cache.hl.Adornee = char end
                        cache.hl.Enabled = true
                        cache.hl.FillColor = col
                        cache.hl.OutlineColor = col
                    elseif cache.hl then cache.hl.Enabled = false end

                    if hasDrawing and cache.box then
                        local headPos, headOn = camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                        local footPos, footOn = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,2.5,0))
                        if headOn and footOn and headPos.Z > 0 then
                            local height = math.abs(headPos.Y - footPos.Y)
                            local width = height * 0.6
                            local bx = headPos.X - width/2
                            local by = headPos.Y

                            if ESP.box then
                                cache.box.Visible = true
                                cache.box.Position = Vector2.new(bx, by)
                                cache.box.Size = Vector2.new(width, height)
                                cache.box.Color = col
                            else cache.box.Visible = false end

                            if ESP.filled then
                                cache.filled.Visible = true
                                cache.filled.Position = Vector2.new(bx, by)
                                cache.filled.Size = Vector2.new(width, height)
                                cache.filled.Color = col
                            else cache.filled.Visible = false end

                            if ESP.corner then
                                local cs = math.min(width, height) * 0.25
                                local pts = {
                                    {bx, by, bx+cs, by}, {bx, by, bx, by+cs},
                                    {bx+width, by, bx+width-cs, by}, {bx+width, by, bx+width, by+cs},
                                    {bx, by+height, bx+cs, by+height}, {bx, by+height, bx, by+height-cs},
                                    {bx+width, by+height, bx+width-cs, by+height}, {bx+width, by+height, bx+width, by+height-cs},
                                }
                                for i, l in ipairs(cache.corners) do
                                    local p = pts[i]
                                    l.Visible = true
                                    l.From = Vector2.new(p[1], p[2])
                                    l.To = Vector2.new(p[3], p[4])
                                    l.Color = col
                                end
                            else for _, l in pairs(cache.corners) do l.Visible = false end end

                            if ESP.health and hum then
                                local hp = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                                local hbX = bx - 6
                                cache.hBg.Visible = true
                                cache.hBg.Position = Vector2.new(hbX, by)
                                cache.hBg.Size = Vector2.new(3, height)
                                cache.hBar.Visible = true
                                cache.hBar.Position = Vector2.new(hbX, by + height * (1 - hp))
                                cache.hBar.Size = Vector2.new(3, height * hp)
                                if hp > 0.6 then cache.hBar.Color = Color3.fromRGB(0, 255, 80)
                                elseif hp > 0.3 then cache.hBar.Color = Color3.fromRGB(255, 200, 0)
                                else cache.hBar.Color = Color3.fromRGB(255, 40, 40) end
                            else cache.hBg.Visible = false; cache.hBar.Visible = false end

                            if ESP.healthText and hum then
                                local hp = math.floor(hum.Health)
                                local maxHp = math.floor(hum.MaxHealth)
                                local ratio = hp / math.max(maxHp, 1)
                                cache.hpText.Visible = true
                                cache.hpText.Position = Vector2.new(bx + width/2, by + height/2 - 6)
                                cache.hpText.Text = hp .. "/" .. maxHp
                                if ratio > 0.6 then cache.hpText.Color = Color3.fromRGB(0, 255, 80)
                                elseif ratio > 0.3 then cache.hpText.Color = Color3.fromRGB(255, 200, 0)
                                else cache.hpText.Color = Color3.fromRGB(255, 40, 40) end
                            elseif cache.hpText then cache.hpText.Visible = false end

                            if ESP.name then
                                cache.name.Visible = true
                                cache.name.Position = Vector2.new(headPos.X, by - 20)
                                cache.name.Text = plr.Name
                                cache.name.Color = col
                            else cache.name.Visible = false end

                            if ESP.distance then
                                cache.dist.Visible = true
                                cache.dist.Position = Vector2.new(headPos.X, by + height + 8)
                                cache.dist.Text = tostring(math.floor((camera.CFrame.Position - hrp.Position).Magnitude))
                                cache.dist.Color = col
                            else cache.dist.Visible = false end

                            if ESP.tracers then
                                cache.tracer.Visible = true
                                cache.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                                cache.tracer.To = Vector2.new(headPos.X, headPos.Y)
                                cache.tracer.Color = col
                            else cache.tracer.Visible = false end

                            if ESP.headDot then
                                cache.headDot.Visible = true
                                cache.headDot.Position = Vector2.new(headPos.X, headPos.Y)
                                cache.headDot.Color = col
                            else cache.headDot.Visible = false end

                            if ESP.skeleton then
                                local sk = getSkeletonPoints(char)
                                if sk then
                                    local function wp(part)
                                        if not part then return nil end
                                        local p, on = camera:WorldToViewportPoint(part.Position)
                                        if on and p.Z > 0 then return Vector2.new(p.X, p.Y) end
                                        return nil
                                    end
                                    local hPos, hrpPos = wp(sk.head), wp(sk.hrp)
                                    local laPos, raPos = wp(sk.larm), wp(sk.rarm)
                                    local llPos, rlPos = wp(sk.lleg), wp(sk.rleg)
                                    local lhPos, rhPos = wp(sk.lhand), wp(sk.rhand)
                                    local lfPos, rfPos = wp(sk.lfoot), wp(sk.rfoot)
                                    local connections = {
                                        {hPos, hrpPos}, {hrpPos, laPos}, {hrpPos, raPos},
                                        {hrpPos, llPos}, {hrpPos, rlPos},
                                        {laPos, lhPos}, {raPos, rhPos},
                                        {llPos, lfPos}, {rlPos, rfPos}, {laPos, raPos},
                                    }
                                    local idx = 1
                                    for _, conn in ipairs(connections) do
                                        local a, b = conn[1], conn[2]
                                        if a and b and cache.skeletonLines[idx] then
                                            local line = cache.skeletonLines[idx]
                                            line.Visible = true
                                            line.From = a; line.To = b; line.Color = col
                                            idx = idx + 1
                                        end
                                    end
                                    for i = idx, #cache.skeletonLines do cache.skeletonLines[i].Visible = false end
                                end
                            else
                                for _, l in pairs(cache.skeletonLines) do l.Visible = false end
                            end

                            if cache.arrow then cache.arrow.Visible = false end
                        else
                            if ESP.offscreen and cache.arrow then
                                local hrpPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                                if not onScreen or hrpPos.Z <= 0 then
                                    local screenCenter = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
                                    local dir = (Vector2.new(hrpPos.X, hrpPos.Y) - screenCenter)
                                    if dir.Magnitude < 1 then dir = Vector2.new(1, 0) end
                                    dir = dir.Unit
                                    local edgeDist = math.min(camera.ViewportSize.X, camera.ViewportSize.Y) * 0.4
                                    local arrowPos = screenCenter + dir * edgeDist
                                    local perp = Vector2.new(-dir.Y, dir.X)
                                    cache.arrow.Visible = true
                                    cache.arrow.PointA = arrowPos + dir * 15
                                    cache.arrow.PointB = arrowPos + perp * 10 - dir * 5
                                    cache.arrow.PointC = arrowPos - perp * 10 - dir * 5
                                    cache.arrow.Color = col
                                else cache.arrow.Visible = false end
                            elseif cache.arrow then cache.arrow.Visible = false end

                            hideEsp(cache)
                        end
                    end
                end
            end
        end
    end
end)

