local function isVisibleToCamera(plr, hrp)
    if not hrp then return false end
    local origin = camera.CFrame.Position
    local dir = hrp.Position - origin
    local params = RaycastParams.new()
    pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end)
    if params.FilterType ~= Enum.RaycastFilterType.Exclude then
        pcall(function() params.FilterType = Enum.RaycastFilterType.Blacklist end)
    end
    local filter = {camera, espFolder}
    if plr.Character then table.insert(filter, plr.Character) end
    if player.Character then table.insert(filter, player.Character) end
    params.FilterDescendantsInstances = filter
    local r = workspace:Raycast(origin, dir, params)
    return r == nil
end

local function newEsp()
    local cache = {}
    local h = Instance.new("Highlight")
    h.Name = "AM_HL"
    h.FillTransparency = 0.55
    h.OutlineTransparency = 0
    pcall(function() h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end)
    h.Parent = espFolder
    cache.hl = h

    if hasDrawing then
        pcall(function()
            cache.box = Drawing.new("Square"); cache.box.Visible = false; cache.box.Thickness = 1; cache.box.Filled = false
            cache.filled = Drawing.new("Square"); cache.filled.Visible = false; cache.filled.Thickness = 0; cache.filled.Filled = true; cache.filled.Transparency = 0.75
            cache.corners = {}
            for i=1,8 do local line = Drawing.new("Line"); line.Visible = false; line.Thickness = 2; cache.corners[i] = line end
            cache.hBg = Drawing.new("Square"); cache.hBg.Visible = false; cache.hBg.Thickness = 0; cache.hBg.Filled = true; cache.hBg.Transparency = 0.3; cache.hBg.Color = Color3.fromRGB(0,0,0)
            cache.hBar = Drawing.new("Square"); cache.hBar.Visible = false; cache.hBar.Thickness = 0; cache.hBar.Filled = true; cache.hBar.Transparency = 0.15
            cache.hpText = Drawing.new("Text"); cache.hpText.Visible = false; cache.hpText.Size = 14; cache.hpText.Center = true; cache.hpText.Outline = true; cache.hpText.OutlineColor = Color3.fromRGB(0,0,0); cache.hpText.Font = 2; cache.hpText.Color = Color3.fromRGB(255,255,255)
            cache.name = Drawing.new("Text"); cache.name.Visible = false; cache.name.Size = 16; cache.name.Center = true; cache.name.Outline = true; cache.name.OutlineColor = Color3.fromRGB(0,0,0); cache.name.Font = 2
            cache.dist = Drawing.new("Text"); cache.dist.Visible = false; cache.dist.Size = 14; cache.dist.Center = true; cache.dist.Outline = true; cache.dist.OutlineColor = Color3.fromRGB(0,0,0); cache.dist.Font = 2
            cache.tracer = Drawing.new("Line"); cache.tracer.Visible = false; cache.tracer.Thickness = 1
            cache.headDot = Drawing.new("Circle"); cache.headDot.Visible = false; cache.headDot.Thickness = 1; cache.headDot.Filled = true; cache.headDot.Radius = 4
            cache.skeletonLines = {}
            for i=1,20 do local line = Drawing.new("Line"); line.Visible = false; line.Thickness = 1; line.Color = Color3.fromRGB(255,255,255); cache.skeletonLines[i] = line end
            cache.arrow = Drawing.new("Triangle"); cache.arrow.Visible = false; cache.arrow.Thickness = 1; cache.arrow.Filled = true
        end)
    end
    return cache
