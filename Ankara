    if not flyBV or flyBV.Parent ~= hrp then startFly() end
    if not flyBV then return end

    local move = Vector3.new(0,0,0)
    local camCF = camera.CFrame
    local dir = PLAYER.flyDir
    if dir == "up" then move = Vector3.new(0,1,0)
    elseif dir == "down" then move = Vector3.new(0,-1,0)
    elseif dir == "left" then move = -camCF.RightVector
    elseif dir == "right" then move = camCF.RightVector
    elseif dir == "forward" then move = camCF.LookVector
    end
    if move.Magnitude > 0 then move = move.Unit end

    flyBV.Velocity = move * PLAYER.flySpeed
    flyBG.CFrame = camCF
end)

