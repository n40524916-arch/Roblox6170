-- Kullanıcı butona basıp parmağını kaydırırsa (scroll) click tetiklenmez
local function makeScrollSafeButton(btn, onClick)
    local pressPos = nil
    local moved = false
    local threshold = 8

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            pressPos = input.Position
            moved = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not pressPos then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = (input.Position - pressPos).Magnitude
            if d > threshold then moved = true end
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if pressPos and not moved then
                if onClick then pcall(onClick) end
            end
            pressPos = nil
            moved = false
        end
    end)
end

